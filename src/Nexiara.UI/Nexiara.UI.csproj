<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>

		<!-- ⚡ Имя итогового .exe файла (будет Nexiara.exe) -->
		<AssemblyName>Nexiara</AssemblyName>

		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<ApplicationIcon>app.ico</ApplicationIcon>

		<!-- 🛠️ Настройки для пуленепробиваемой сборки в один автономный .exe -->
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<PublishSingleFile>true</PublishSingleFile>
		<SelfContained>true</SelfContained>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
		<EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Nexiara.Protocol\Nexiara.Protocol.csproj" />
		<ProjectReference Include="..\Nexiara.Abstractions\Nexiara.Abstractions.csproj" />
		<ProjectReference Include="..\Nexiara.Core\Nexiara.Core.csproj" />
		<ProjectReference Include="..\Nexiara.Platform.Windows\Nexiara.Platform.Windows.csproj" />
		<ProjectReference Include="..\Nexiara.Streaming\Nexiara.Streaming.csproj" />
	</ItemGroup>

</Project>