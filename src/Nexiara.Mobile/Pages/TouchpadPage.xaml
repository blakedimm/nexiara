<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Nexiara.Mobile.ViewModels"
             xmlns:controls="clr-namespace:Nexiara.Mobile.Pages.Controls"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="Nexiara.Mobile.Pages.TouchpadPage"
             BackgroundColor="{StaticResource OledBackground}"
             Title="CONTROL DECK">

    <ContentPage.BindingContext>
        <vm:TouchpadViewModel x:Name="ViewModel" />
    </ContentPage.BindingContext>

    <Grid x:Name="MainLayout" RowDefinitions="Auto, Auto, *, Auto" Padding="16" RowSpacing="12">

        <!-- 1. ВЕРХНИЙ CYBER HUD -->
        <Border Grid.Row="0" Style="{StaticResource GlassCardStyle}" Padding="12,10">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
                    <Border x:Name="StatusDot" WidthRequest="10" HeightRequest="10" 
                            StrokeThickness="0" BackgroundColor="{StaticResource CyberCyan}">
                        <Border.StrokeShape>
                            <shapes:RoundRectangle CornerRadius="5" />
                        </Border.StrokeShape>
                    </Border>
                    <Label Text="{Binding PcName}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout Grid.Column="2" Spacing="12" VerticalOptions="Center">
                    <Label x:Name="FpsLabel" Text="60 FPS" FontSize="11" TextColor="{StaticResource CyberCyan}" FontAttributes="Bold" VerticalOptions="Center"/>
                    <!-- Исправленная кнопка настроек без битой иконки -->
                    <Button Text="⚙" FontSize="16" TextColor="{StaticResource CyberCyan}" BackgroundColor="Transparent" Padding="0" WidthRequest="32" HeightRequest="32" Clicked="ToggleSettings_Clicked"/>
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <!-- 2. ВЫПАДАЮЩАЯ ПАНЕЛЬ НАСТРОЕК -->
        <Border x:Name="SettingsPanel" Grid.Row="1" IsVisible="False" Style="{StaticResource GlassCardStyle}" Padding="14" Margin="0,0,0,4">
            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="*, Auto">
                    <Label Text="ЧУВСТВИТЕЛЬНОСТЬ ТАЧПАДА" FontSize="11" TextColor="{StaticResource TextSecondary}" FontAttributes="Bold" CharacterSpacing="1"/>
                    <Label x:Name="SensitivityLabel" Grid.Column="1" Text="1.8x" FontSize="11" TextColor="{StaticResource CyberCyan}" FontAttributes="Bold"/>
                </Grid>
                <Slider x:Name="SensitivitySlider" Minimum="0.5" Maximum="4.0" Value="1.8" 
                        MinimumTrackColor="{StaticResource CyberCyan}" 
                        MaximumTrackColor="{StaticResource GlassBorder}" 
                        ThumbColor="{StaticResource CyberCyan}" 
                        ValueChanged="SensitivitySlider_ValueChanged"/>
            </VerticalStackLayout>
        </Border>

        <!-- 3. ОСНОВНАЯ СЕНСОРНАЯ ЗОНА -->
        <Grid Grid.Row="2" ColumnDefinitions="*, Auto" ColumnSpacing="10">

            <Border x:Name="VideoBorder" Grid.Column="0" BackgroundColor="#000000" Stroke="{StaticResource CyberCyan}" StrokeThickness="1.5">
                <Border.StrokeShape>
                    <shapes:RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <Grid x:Name="VideoContainer" BackgroundColor="Transparent">
                    <controls:VideoSurface HorizontalOptions="Fill" VerticalOptions="Fill" />

                    <Label x:Name="StatusLabel" 
                           Text="ПОДКЛЮЧЕНИЕ К ПК..." 
                           TextColor="{StaticResource TextMuted}" 
                           FontSize="12" 
                           FontAttributes="Bold" 
                           CharacterSpacing="1"
                           HorizontalOptions="Center" 
                           VerticalOptions="Center" 
                           InputTransparent="True" />
                </Grid>
            </Border>

            <Border Grid.Column="1" WidthRequest="38" Style="{StaticResource GlassCardStyle}" Padding="0">
                <Grid x:Name="ScrollStripContainer" BackgroundColor="Transparent">
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="14" InputTransparent="True">
                        <Label Text="▲" FontSize="10" TextColor="{StaticResource CyberCyan}" HorizontalOptions="Center"/>
                        <Label Text="SCRL" FontSize="8" TextColor="{StaticResource TextSecondary}" FontAttributes="Bold" CharacterSpacing="1" HorizontalOptions="Center"/>
                        <Label Text="▼" FontSize="10" TextColor="{StaticResource CyberCyan}" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </Grid>

        <!-- 4. НИЖНЯЯ ПАНЕЛЬ СИСТЕМНЫХ ХОТКЕЕВ -->
        <Grid Grid.Row="3" ColumnDefinitions="*, *, *, *" ColumnSpacing="8">
            <Button Grid.Column="0" Text="ESC" HeightRequest="38" FontSize="11" FontAttributes="Bold" CornerRadius="10" BackgroundColor="{StaticResource SurfaceCard}" TextColor="{StaticResource TextSecondary}" BorderColor="{StaticResource GlassBorder}" BorderWidth="1" Clicked="QuickKey_Clicked" CommandParameter="esc"/>
            <Button Grid.Column="1" Text="TAB" HeightRequest="38" FontSize="11" FontAttributes="Bold" CornerRadius="10" BackgroundColor="{StaticResource SurfaceCard}" TextColor="{StaticResource TextSecondary}" BorderColor="{StaticResource GlassBorder}" BorderWidth="1" Clicked="QuickKey_Clicked" CommandParameter="tab"/>
            <Button Grid.Column="2" Text="ALT+TAB" HeightRequest="38" FontSize="11" FontAttributes="Bold" CornerRadius="10" BackgroundColor="{StaticResource SurfaceCard}" TextColor="{StaticResource CyberCyan}" BorderColor="{StaticResource GlassBorder}" BorderWidth="1" Clicked="QuickKey_Clicked" CommandParameter="alt_tab"/>
            <Button Grid.Column="3" Text="TASK MGR" HeightRequest="38" FontSize="10" FontAttributes="Bold" CornerRadius="10" BackgroundColor="{StaticResource SurfaceCard}" TextColor="{StaticResource CyberCyan}" BorderColor="{StaticResource GlassBorder}" BorderWidth="1" Clicked="QuickKey_Clicked" CommandParameter="task_mgr"/>
        </Grid>
    </Grid>
</ContentPage>