<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- 🌌 ТЕМНАЯ КИБЕРПАНК ПАЛИТРА (OLED CYBERDECK) -->

    <!-- Основные фоны (True OLED Black) -->
    <Color x:Key="OledBackground">#08080C</Color>
    <Color x:Key="SurfaceDark">#10101C</Color>
    <Color x:Key="SurfaceCard">#161628</Color>
    <Color x:Key="SurfaceElevated">#1E1E36</Color>

    <!-- Акценты и свечение -->
    <Color x:Key="CyberCyan">#00E5FF</Color>
    <Color x:Key="CyberCyanGlow">#3300E5FF</Color>
    <Color x:Key="NeonViolet">#9D4EDD</Color>
    <Color x:Key="NeonVioletGlow">#339D4EDD</Color>

    <!-- Границы и рамки (Glassmorphism Line) -->
    <Color x:Key="GlassBorder">#282845</Color>
    <Color x:Key="GlassBorderActive">#00E5FF</Color>

    <!-- Текст -->
    <Color x:Key="TextPrimary">#FFFFFF</Color>
    <Color x:Key="TextSecondary">#8A8A9E</Color>
    <Color x:Key="TextMuted">#505068</Color>

    <!-- Статусы -->
    <Color x:Key="StatusSuccess">#00E676</Color>
    <Color x:Key="StatusWarning">#FFD600</Color>
    <Color x:Key="StatusDanger">#FF3366</Color>

    <!-- Кисти (Brushes) -->
    <SolidColorBrush x:Key="OledBackgroundBrush" Color="{StaticResource OledBackground}" />
    <SolidColorBrush x:Key="SurfaceDarkBrush" Color="{StaticResource SurfaceDark}" />
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="{StaticResource SurfaceCard}" />
    <SolidColorBrush x:Key="CyberCyanBrush" Color="{StaticResource CyberCyan}" />
    <SolidColorBrush x:Key="GlassBorderBrush" Color="{StaticResource GlassBorder}" />

</ResourceDictionary>