<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Nexiara.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Nexiara.Mobile.Pages"
    Shell.FlyoutBehavior="Disabled"
    Shell.TabBarBackgroundColor="{StaticResource OledBackground}"
    Shell.TabBarForegroundColor="{StaticResource CyberCyan}"
    Shell.TabBarTitleColor="{StaticResource CyberCyan}"
    Shell.TabBarUnselectedColor="{StaticResource TextMuted}">

    <TabBar>
        <Tab Title="ПОИСК ПК">
            <ShellContent ContentTemplate="{DataTemplate pages:MainPage}" Route="MainPage" />
        </Tab>
        <Tab Title="ТАЧПАД">
            <ShellContent ContentTemplate="{DataTemplate pages:TouchpadPage}" Route="TouchpadPage" />
        </Tab>
        <Tab Title="КЛАВИАТУРА">
            <ShellContent ContentTemplate="{DataTemplate pages:KeyboardPage}" Route="KeyboardPage" />
        </Tab>
        <Tab Title="СТАТУС">
            <ShellContent ContentTemplate="{DataTemplate pages:TelemetryPage}" Route="TelemetryPage" />
        </Tab>
    </TabBar>

</Shell>