<Window x:Class="NexiaraClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexiara Core" Height="450" Width="350"
        Background="#0B0B12" Foreground="#E0E0E0"
        WindowStyle="ToolWindow" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3D3DB8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="*"/>    <RowDefinition Height="Auto"/> </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="NEXIARA CLIENT" FontSize="20" FontWeight="Black" Foreground="#00FF66" HorizontalAlignment="Center"/>
            <TextBlock x:Name="StatusText" Text="Состояние: Ожидание..." FontSize="12" Foreground="#888888" HorizontalAlignment="Center" Margin="0,5,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <TextBlock Text="Идентификатор устройства (UUID / PIN):" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,5"/>
            <TextBox x:Name="DeviceUuidBox" Text="NODE-TEST-1234" Background="#161622" Foreground="White" BorderBrush="#333" Padding="5" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,20">
            <TextBlock Text="⚙ НАСТРОЙКИ ТРАНСЛЯЦИИ" FontSize="12" FontWeight="Bold" Foreground="#AAAAAA" Margin="0,0,0,10"/>
            
            <TextBlock Text="Разрешение захвата:" FontSize="11" Foreground="#888888"/>
            <ComboBox x:Name="ResolutionCombo" Background="#161622" Foreground="Black" Margin="0,5,0,15" Padding="5">
                <ComboBoxItem Content="2560x1440 (Native QHD) - Максимум" />
                <ComboBoxItem Content="1920x1080 (FHD)" />
                <ComboBoxItem Content="1280x720 (Оптимально для Mobile)" IsSelected="True"/>
            </ComboBox>

            <CheckBox x:Name="HwAccelCheck" Content="Аппаратное ускорение (NVENC)" Foreground="#E0E0E0" IsChecked="True" Margin="0,0,0,10"/>
            <CheckBox x:Name="AutoStartAgentCheck" Content="Запускать фоновый агент при старте ПК" Foreground="#E0E0E0" IsChecked="True"/>
        </StackPanel>

        <Button x:Name="ToggleStreamButton" Grid.Row="4" Content="ЗАПУСТИТЬ ТРАНСЛЯЦИЮ" Height="45" FontSize="14" Click="ToggleStreamButton_Click"/>
    </Grid>
</Window>